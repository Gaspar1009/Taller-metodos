public class Ejercicio08_TablaMultiplicar {
    public static int[] generarTablaMultiplicar(int numero) {
        int[] tabla = new int[10];
        for (int i = 0; i < 10; i++) {
            tabla[i] = numero * (i + 1);
        }
        return tabla;
    }

    public static void main(String[] args) {
        int[] tabla5 = generarTablaMultiplicar(5);
        for (int i = 0; i < tabla5.length; i++) {
            System.out.println("5 x " + (i + 1) + " = " + tabla5[i]);
        }
    }
}
